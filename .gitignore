node_modules
dist
# The vendored NKlein SDK ships prebuilt dist (there is no package source to build
# from in-repo), so it must stay tracked despite the global `dist` ignore above.
!vendor/nklein-sdk/*/dist
!vendor/nklein-sdk/*/dist/**
coverage
.DS_Store
test-results
playwright-report
.worktrees
# !Klein runtime workspace state for this repo-as-a-project (board/config/sessions/CRDT +
# generated plan artifacts) — per-machine generated data, never commit.
.nklein/
# Claude Code agent worktrees (.claude/worktrees/<id>/ are full repo checkouts — embedded git
# repos that must never be committed). Scoped to worktrees so tracked config like
# .claude/commands/ stays under version control.
.claude/worktrees/
.sentry-artifacts
.env
.env.*
!.env.example
web-ui/.env
web-ui/.env.*
!web-ui/.env.example
packages/desktop/out
packages/desktop/cli
packages/desktop/*.tgz
*.code-workspace

# Generated desktop bundles (regenerated by build scripts; never commit)
/disconnected.html
/runtime-orchestrator.js
/kanban-*.tgz
packages/desktop/main.js
packages/desktop/runtime-child.js
packages/desktop/runtime-child-env.js
packages/desktop/desktop-preflight.js
packages/desktop/cli
