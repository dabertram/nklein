{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@runtime-agent-catalog": ["../src/core/agent-catalog.ts"],
      "@runtime-clarification-option-set": ["../src/core/clarification-option-set.ts"],
      "@runtime-nklein-tool-call-display": ["../src/nklein-agent/nklein-tool-call-display.ts"],
      "@runtime-contract": ["../src/core/api-contract.ts"],
      "@runtime-home-agent-session": ["../src/core/home-agent-session.ts"],
      "@runtime-task-context-import": ["../src/core/task-context-import.ts"],
      "@runtime-trpc": ["../src/trpc/app-router.ts"],
      "@runtime-shortcuts": ["../src/config/shortcut-utils.ts"],
      "@runtime-task-id": ["../src/core/task-id.ts"],
      "@runtime-task-title": ["../src/core/task-title.ts"],
      "@runtime-task-worktree-path": ["../src/workspace/task-worktree-path.ts"],
      "@runtime-task-state": ["../src/core/task-board-mutations.ts"],
      "@runtime-operator-board-health": ["../src/core/operator-board-health.ts"],
      "@runtime-agent-stuckness": ["../src/core/agent-stuckness.ts"],
      "@runtime-escalation-suggestions": ["../src/core/escalation-suggestions.ts"]
    },
    "types": ["vitest/globals"]
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
