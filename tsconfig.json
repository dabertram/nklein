{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@cline/sdk": ["./vendor/cline-sdk/packages/sdk/dist"],
      "@cline/core": ["./vendor/cline-sdk/packages/core/dist"],
      "@cline/core/telemetry": ["./vendor/cline-sdk/packages/core/dist/services/telemetry"],
      "@cline/core/hub": ["./vendor/cline-sdk/packages/core/dist/hub"],
      "@cline/agents": ["./vendor/cline-sdk/packages/agents/dist"],
      "@cline/llms": ["./vendor/cline-sdk/packages/llms/dist"],
      "@cline/shared": ["./vendor/cline-sdk/packages/shared/dist"],
      "@cline/shared/db": ["./vendor/cline-sdk/packages/shared/dist/db"],
      "@cline/shared/storage": ["./vendor/cline-sdk/packages/shared/dist/storage"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"]
}
