#!/bin/sh

STAGED_FILES=$(git diff --cached --name-only)

# `git commit -- <pathspec>` (and any commit run with GIT_INDEX_FILE already exported) builds a
# temporary index and hands it to hooks via GIT_INDEX_FILE, alongside GIT_DIR/GIT_PREFIX. Anything
# we run below that shells out to `git` inherits those and silently targets THIS commit's index
# instead of its own repository — a test's `git add` in a temp repo then stages an entry whose blob
# lives in that temp repo, and the commit dies after the hook passes with
# "error: invalid object 100644 <oid> for '<path>' / error: Error building trees".
#
# Only the checks are sanitised, and only inside a subshell: `biome check --staged` below and the
# final re-staging loop must keep the commit's own index, which is exactly what those variables
# point at.
without_git_repo_env() {
	(
		unset GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY \
			GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX GIT_CONFIG GIT_CEILING_DIRECTORIES
		"$@"
	)
}

run_checks() {
	npm run typecheck && npm run test:precommit
}

echo "Running biome check on staged files..."
npx biome check --staged --no-errors-on-unmatched --files-ignore-unknown=true
if [ $? -ne 0 ]; then
	echo "Biome check failed."
	exit 1
fi

echo "Running type checking and fast tests..."
without_git_repo_env run_checks
if [ $? -ne 0 ]; then
	echo "Checks failed."
	exit 1
fi

for file in $STAGED_FILES; do
	if [ -f "$file" ]; then
		git add "$file"
	fi
done

echo "Pre-commit checks passed."
