#!/bin/sh

# Run from the repo top level so the checks (tsc, tests) always run against the right tree, never a subdir.
TOPLEVEL=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -n "$TOPLEVEL" ]; then
	cd "$TOPLEVEL" || exit 1
fi

# Self-heal a spuriously-bare repo. The !Klein repo is a work tree, but a stray `git init` / dev-test git op
# (see the incident note in AGENTS.md) can flip core.bare=true on the shared config — which then breaks EVERY
# work-tree git op with the cryptic "fatal: this operation must be run in a work tree" (while `git tag`/`log`
# still work). If we ever observe that here, undo it before continuing so commits never get wedged by it.
if [ "$(git rev-parse --is-bare-repository 2>/dev/null)" = "true" ]; then
	echo "⚠️  pre-commit: repo was unexpectedly bare (core.bare=true) — restoring core.bare=false."
	git config core.bare false
fi

# Sentinel: only run the heavy checks in the actual !Klein repo. If this hook ever fires in a different repo
# (e.g. a created/dev-test temp repo that somehow inherited this hooks path), skip gracefully instead of failing
# on a missing/foreign package.json — a created or temp repo must never be blocked (or polluted) by !Klein's checks.
if [ ! -f package.json ] || ! grep -q '"name": "nklein"' package.json 2>/dev/null; then
	echo "pre-commit: not the !Klein repo here; skipping !Klein checks."
	exit 0
fi

STAGED_FILES=$(git diff --cached --name-only)

# Never commit an embedded git repo. Agent worktrees live at .claude/worktrees/<id>/ (full repo checkouts); if one
# is ever staged it lands as a gitlink that pollutes the repo and breaks clones (a real incident). .gitignore
# already excludes them, so this is a belt-and-suspenders guard against an accidental `git add` of one.
EMBEDDED=$(printf '%s\n' "$STAGED_FILES" | grep '\.claude/worktrees/' || true)
if [ -n "$EMBEDDED" ]; then
	echo "Refusing to commit paths under .claude/worktrees/ (agent worktrees are not part of this repo):"
	echo "$EMBEDDED"
	exit 1
fi

echo "Running biome check on staged files..."
npx biome check --staged --no-errors-on-unmatched --files-ignore-unknown=true
if [ $? -ne 0 ]; then
	echo "Biome check failed."
	exit 1
fi

# N12: PERSIST the full output on failure. An intermittent test:fast failure has been observed twice, and BOTH
# times its identity was lost — the hook printed a summary and discarded the detail, so 27 subsequent runs across
# four adversarial conditions could not name the test. The bug is not hard to hit; it is hard to HOLD ONTO.
# Capturing costs nothing on the passing path (the log is only kept when something fails).
echo "Running type checking and fast tests..."
CHECK_LOG="${TMPDIR:-/tmp}/nklein-precommit-$(date +%Y%m%d-%H%M%S).log"
# David 2026-08-12: the gate also runs web-ui tsc + the src co-located suites — a web-ui type error slipped
# through once (§10c#11) and the src-only efficiency-prompt budget guard drifted 2 weeks unseen; both are now
# caught at commit time (~+15s).
if npm run typecheck > "$CHECK_LOG" 2>&1 && npm run web:typecheck >> "$CHECK_LOG" 2>&1 && npm run test:precommit >> "$CHECK_LOG" 2>&1; then
	rm -f "$CHECK_LOG"
else
	tail -40 "$CHECK_LOG"
	echo ""
	echo "Checks failed. FULL output kept at: $CHECK_LOG"
	echo "  (If this was an INTERMITTENT failure, that file names the test — see N12 in todo.md.)"
	exit 1
fi

# §5.AZ fork-drift guard: the repo test suites EXCLUDE vendor/**, so an edit to the forked Cline SDK can silently
# rot its OWN tests and never be caught. Run the vendored suites ONLY when this commit stages a vendor/** file, so
# fork drift is caught at the source without adding ~30s to every ordinary commit.
VENDOR_STAGED=$(printf '%s\n' "$STAGED_FILES" | grep '^vendor/' || true)
if [ -n "$VENDOR_STAGED" ]; then
	echo "Staged vendor/** changes detected — running the vendored SDK suites (test:vendor)..."
	npm run test:vendor
	if [ $? -ne 0 ]; then
		echo "Vendored SDK tests failed — a fork edit rotted the SDK's own tests. Fix them (or run 'npm run test:vendor')."
		exit 1
	fi
fi

# Re-stage any formatter touch-ups. Skip paths that are now git-ignored: a file can be staged as a deletion
# (e.g. `git rm --cached`) while still present on disk and newly ignored — re-adding it would fail with
# "paths are ignored ... Use -f" and wedge the commit.
for file in $STAGED_FILES; do
	# `git check-ignore` normally suppresses matches for paths already in the index. `--no-index` is load-bearing:
	# release fixtures may intentionally force-track runtime state below an ignored directory, and re-adding such a
	# path without `-f` wedges the commit after every expensive test suite has already passed.
	if [ -f "$file" ] && ! git check-ignore --no-index -q "$file"; then
		git add "$file"
	fi
done

echo "Pre-commit checks passed."
